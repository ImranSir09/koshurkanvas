rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidDocument(data) {
      return data.id is string && data.id.size() <= 128
        && data.title is string && data.title.size() <= 200
        && data.content is string && data.content.size() <= 20000;
    }

    function isValidDesign(data) {
      return data.id is string && data.id.size() <= 128
        && data.title is string && data.title.size() <= 200
        && data.preset is string && data.preset.size() <= 50
        && data.width is number && data.width > 0 && data.width <= 10000
        && data.height is number && data.height > 0 && data.height <= 10000;
    }

    function isValidUser(data) {
      return data.uid is string && data.uid.size() <= 128
        && data.email is string && data.email.size() <= 200;
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Test connection doc
    match /test/{docId} {
      allow read: if true;
    }

    // Documents collection
    match /documents/{documentId} {
      allow read: if isValidId(documentId);
      allow create, update: if isValidId(documentId) && isValidDocument(incoming());
      allow delete: if isValidId(documentId);
    }

    // Designs collection
    match /designs/{designId} {
      allow read: if isValidId(designId);
      allow create, update: if isValidId(designId) && isValidDesign(incoming());
      allow delete: if isValidId(designId);
    }

    // Users collection
    match /users/{userId} {
      allow read: if isValidId(userId);
      allow create, update: if isValidId(userId) && isValidUser(incoming());
      allow delete: if isOwner(userId);
    }
  }
}
